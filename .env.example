# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Values here are only used to fill variables that are NOT already set in the real
# environment: OS environment > project .env > working-directory .env.
# A missing .env is a silent no-op.
#
# Referenced from sqlferret.config.json as ${SQLFERRET_AUTH}.
# See docs/configuration.md and docs/privacy.md.
SQLFERRET_AUTH=User ID=sa;Password=CHANGE_ME;TrustServerCertificate=True

# Optional: connection string used by the environment-gated integration tests.
# Absent means those tests skip cleanly. See docs/development.md.
# SQLFERRET_TEST_CONN=Server=localhost;Database=tempdb;User ID=sa;Password=CHANGE_ME;TrustServerCertificate=True
